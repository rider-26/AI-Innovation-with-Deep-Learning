# Copy this file to .env and fill it in. .env is git-ignored: never commit a real key.
# The LLM provider is not confirmed yet (waiting on Mr Wee's approved list and API budget).

LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Guardrails for the agent: hard limits per run, to stop loops and runaway cost
AGENT_MAX_TOOL_CALLS=25
AGENT_MAX_TOKENS=20000
